# Copy to .env to override defaults. Every variable is optional.

# ---- Backend (FastAPI) ----
WINDDESK_LOG_LEVEL=INFO
# JSON structured logs (true) or plain text (false)
WINDDESK_LOG_JSON=true
# Directory holding manifest.json + *.csv.gz (default: backend/data/snapshot)
# WINDDESK_SNAPSHOT_DIR=/app/backend/data/snapshot
# Serve the built React app from FastAPI (set automatically in the Docker image)
# WINDDESK_FRONTEND_DIST=/app/frontend/dist
# Only needed if the UI is served from a different origin than the API (JSON list)
# WINDDESK_CORS_ORIGINS=["https://example.vercel.app"]

# ---- Ingestion (scripts/ingest.py) ----
WINDDESK_ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
WINDDESK_HTTP_TIMEOUT_S=30
WINDDESK_HTTP_MAX_RETRIES=4
WINDDESK_HTTP_BACKOFF_S=1.0

# ---- Frontend (build time, Vite) ----
# Base URL of the API if it is not same-origin (default: same origin, /api/v1)
# VITE_API_BASE=https://api.example.com
# Dev-server proxy target for /api
# VITE_API_PROXY=http://localhost:8000
